# Spartask production settings. `spartaskctl install` writes this file as .env (mode 600) with
# generated secrets; edit it afterwards and apply with `spartaskctl restart`.
# Never commit .env. Keep a copy of SECRET_KEY somewhere safe: without it the stored data source
# and mail server passwords cannot be decrypted, even from a backup.

# --- Stack -------------------------------------------------------------------------------------
# compose.yml plus optional overlays (separator ":"); docker compose reads this variable itself.
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT_NAME=spartask
SPARTASK_IMAGE=ghcr.io/spartaskai/spartask
# Release to run; `spartaskctl update <version>` changes it.
SPARTASK_VERSION=1.0.0
# Internal Docker network (change only if it collides with your LAN).
SPARTASK_SUBNET=172.30.10.0/24

# --- Domain and TLS ----------------------------------------------------------------------------
# The app answers on this domain and on every company subdomain (acme.example.com), so DNS needs
# an A record for the domain and a wildcard (*) record.
SPARTASK_DOMAIN=example.com
# "/certs/cert.pem /certs/key.pem": certificate files in ./certs covering the domain and *.domain
#   (Cloudflare Origin Certificate, or your company's certificate)
# "internal": Caddy issues its own certificates (closed networks; browsers must trust Caddy's CA)
SPARTASK_TLS=/certs/cert.pem /certs/key.pem
# Proxies allowed to report the client IP. private_ranges, or the Cloudflare ranges when the
# domain is proxied by Cloudflare (spartaskctl install fills them in).
CADDY_TRUSTED_PROXIES=private_ranges

# --- Database ----------------------------------------------------------------------------------
DB_USER=spartask
DB_NAME=spartask
DB_PASSWORD=

# --- Secrets (generated) -----------------------------------------------------------------------
# Encrypts data source / mail server / AI provider passwords at rest. Never change it after install.
SECRET_KEY=
# Signs web sessions (>= 32 bytes).
WEB_AUTH_JWT_SECRET=

# --- AI ----------------------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# --- Mail (invitations) ------------------------------------------------------------------------
# Many cloud providers block outbound SMTP; prefer a mail service's SMTP relay on 587.
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=587
INVITATION_SMTP_USER=
INVITATION_SMTP_PASSWORD=
INVITATION_SMTP_FROM=
INVITATION_TTL=72h
INVITATION_HOURLY_LIMIT=50

# --- Sign-in -----------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Marketplace connection --------------------------------------------------------------------
# Marketplace web address shown in the studio (empty: link hidden).
SPARTASK_MARKETPLACE_URL=
# Marketplace API for online module installation (empty: offline delivery only).
MARKETPLACE_API_URL=
# Marketplace license public key (empty: the key built into the release).
MARKETPLACE_PUBLIC_KEY=
MARKETPLACE_ALLOWED_ORIGINS=
MARKETPLACE_SSO_ENABLED=false
MARKETPLACE_SSO_SHARED_SECRET=
MARKETPLACE_SSO_ISSUER=spartask-platform
MARKETPLACE_SSO_AUDIENCE=spartask-marketplace
MARKETPLACE_SSO_CALLBACK_URL=
MARKETPLACE_RECEIPT_AUDIENCE=spartask-marketplace-receipts

# --- Marketplace server (only with compose.marketplace.yml) -------------------------------------
MARKETPLACE_DOMAIN=
MARKETPLACE_VERSION=
MARKETPLACE_DB_PASSWORD=

# --- Mobile app --------------------------------------------------------------------------------
# Put the APK at ./mobile/spartask.apk; the web portal offers it with a QR code.
MOBILE_APP_VERSION=
MOBILE_APK_URL=
SPARTASK_PUBLIC_API_URL=

# --- MCP (off by default) ----------------------------------------------------------------------
MCP_ENABLED=false
MCP_TOKEN_ISSUANCE_ENABLED=false

# --- Backups -----------------------------------------------------------------------------------
# Number of backups `spartaskctl backup` keeps in ./backups.
BACKUP_KEEP=14
