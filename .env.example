# Spartask production settings. `spartaskctl install` writes this file as .env (mode 600) with
# generated secrets; edit it afterwards and apply with `spartaskctl restart`.
# Never commit .env. Keep a copy of SECRET_KEY somewhere safe: without it the stored data source
# and mail server passwords cannot be decrypted, even from a backup.

# --- Stack -------------------------------------------------------------------------------------
# compose.yml plus optional overlays (separator ":"); docker compose reads this variable itself.
COMPOSE_FILE=compose.yml
COMPOSE_PROJECT_NAME=spartask
SPARTASK_IMAGE=ghcr.io/spartaskai/spartask
# Release to run; `spartaskctl update <version>` changes it.
SPARTASK_VERSION=1.0.0
# Internal Docker networks (change only if they collide with your LAN).
SPARTASK_SUBNET=172.30.10.0/24
MARKETPLACE_FRONT_SUBNET=172.30.11.0/24
MARKETPLACE_DATA_SUBNET=172.30.12.0/24

# --- Company connection targets ----------------------------------------------------------------
# Data sources, SMTP servers, AI endpoints, webhooks, MCP servers and file downloads of company
# processes. The stack's own networks, loopback and cloud metadata are always denied; private
# networks (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) are denied unless allowed below.
# Further addresses to deny (comma-separated IPs/CIDRs). Add the server's own public IP(s) when
# the domain is behind Cloudflare; without Cloudflare that IP is also your domain's address, and
# denying it would block company processes from calling your own Spartask API.
SPARTASK_EGRESS_DENY_CIDRS=
# true: every company may reach private networks (single-company on-premise installations).
SPARTASK_EGRESS_ALLOW_PRIVATE=false
# Per-company exceptions (JSON). tenant = company schema name; host, port and CIDRs must match:
# [{"tenant":"tenant_acme","host":"db.customer.example","port":5432,"cidrs":["10.80.4.20/32"]}]
SPARTASK_EGRESS_PRIVATE_GRANTS=

# --- Domain and TLS ----------------------------------------------------------------------------
# The app answers on this domain and on every company subdomain (acme.example.com), so DNS needs
# an A record for the domain and a wildcard (*) record.
SPARTASK_DOMAIN=example.com
# "/certs/cert.pem /certs/key.pem": certificate files in ./certs covering the domain and *.domain
#   (Cloudflare Origin Certificate, or your company's certificate)
# "internal": Caddy issues its own certificates (closed networks; browsers must trust Caddy's CA)
SPARTASK_TLS=/certs/cert.pem /certs/key.pem
# Proxies allowed to report the client IP. private_ranges, or the Cloudflare ranges when the
# domain is proxied by Cloudflare (spartaskctl install fills them in).
CADDY_TRUSTED_PROXIES=private_ranges

# --- Database ----------------------------------------------------------------------------------
DB_USER=spartask
DB_NAME=spartask
DB_PASSWORD=

# --- Secrets (generated) -----------------------------------------------------------------------
# Encrypts data source / mail server / AI provider passwords at rest. Never change it after install.
SECRET_KEY=
# Signs web sessions (>= 32 bytes).
WEB_AUTH_JWT_SECRET=
# Internal NATS authentication (generated by install; update/restart add it to older .env files).
NATS_AUTH_TOKEN=

# --- AI ----------------------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# --- Mail (invitations) ------------------------------------------------------------------------
# Also sends the sign-up confirmation e-mails: without it, password sign-up is disabled in production.
# DigitalOcean and many clouds block ports 25, 465 and 587: use a mail service relay on port 2525 (e.g. Brevo smtp-relay.brevo.com:2525).
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=2525
INVITATION_SMTP_USER=
INVITATION_SMTP_PASSWORD=
INVITATION_SMTP_FROM=
INVITATION_TTL=72h
INVITATION_HOURLY_LIMIT=50

# --- Sign-in -----------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Marketplace connection --------------------------------------------------------------------
# Marketplace web address shown in the studio (empty: link hidden).
SPARTASK_MARKETPLACE_URL=
# Marketplace API for online module installation (empty: offline delivery only).
MARKETPLACE_API_URL=
# Marketplace license public key (empty: the key built into the release).
MARKETPLACE_PUBLIC_KEY=
MARKETPLACE_ALLOWED_ORIGINS=
MARKETPLACE_SSO_ENABLED=false
MARKETPLACE_SSO_SHARED_SECRET=
MARKETPLACE_SSO_ISSUER=spartask-platform
MARKETPLACE_SSO_AUDIENCE=spartask-marketplace
MARKETPLACE_SSO_CALLBACK_URL=
MARKETPLACE_RECEIPT_AUDIENCE=spartask-marketplace-receipts

# --- Marketplace server (only with compose.marketplace.yml) -------------------------------------
MARKETPLACE_DOMAIN=
MARKETPLACE_VERSION=
MARKETPLACE_DB_PASSWORD=

# --- Platform events (optional) -------------------------------------------------------------------
# tenant.created (a company confirmed its sign-up) is POSTed here with X-Webhook-Token, e.g. to an
# API listener (WEBHOOK_LISTENER) process of your own company:
#   https://<your-company>.<domain>/api/webhooks/tenant-created   token = the listener's security token
PLATFORM_EVENTS_WEBHOOK_URL=
PLATFORM_EVENTS_WEBHOOK_TOKEN=
# Company directory API (GET /api/platform/tenants) for reminders and reporting. Only the
# companies listed here (public.tenants.id, comma-separated) may call it; all others get 401.
SPARTASK_PLATFORM_TENANT_IDS=
# Optional token for processes of those companies (header X-Spartask-Platform-Token,
# >= 32 characters, e.g. openssl rand -hex 32). Without it an ADMIN web session is required.
SPARTASK_PLATFORM_API_TOKEN=

# --- Mobile app --------------------------------------------------------------------------------
# Put the APK at ./mobile/spartask.apk; the web portal offers it with a QR code.
MOBILE_APP_VERSION=
MOBILE_APK_URL=
SPARTASK_PUBLIC_API_URL=

# --- MCP (off by default) ----------------------------------------------------------------------
MCP_ENABLED=false
MCP_TOKEN_ISSUANCE_ENABLED=false

# --- Backups -----------------------------------------------------------------------------------
# Number of backups `spartaskctl backup` keeps in ./backups.
BACKUP_KEEP=14
