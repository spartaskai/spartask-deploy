# SparTask production ayarları (şablon).
# `spartaskctl install` bu dosyadan .env üretir (mode 600, şifreler otomatik).
# `spartaskctl config` sunucudaki .env'i bu şablonla karşılaştırır: yeni sürümde gelen eksik ayarları
# ekler, üretilebilen şifreleri üretir ve sizin doldurmanız gerekenleri açıklamalarıyla listeler.
# .env'i asla git'e koymayın. SECRET_KEY'in bir kopyasını şifre yöneticisinde saklayın: o olmadan
# veri kaynağı / mail sunucusu şifreleri yedekten bile çözülemez.
#
# Satır üstündeki "#@" etiketleri spartaskctl içindir:
#   required     boşsa sistem çalışmaz (update/restart durur)
#   recommended  boşsa ilgili özellik kapalı kalır (uyarı verilir)
#   generate     boşsa spartaskctl rastgele üretir; install-only: sadece ilk kurulumda üretilir
#   if=KEY       kural sadece KEY doluysa (if=KEY=değer: KEY bu değerdeyse) geçerlidir
#   stack=marketplace  kural sadece marketplace kuruluysa geçerlidir
#   values=a|b   izin verilen değerler; min=N en az N karakter

# --- Yığın (stack) -------------------------------------------------------------------------------
# Kullanılan compose dosyaları (":" ile ayrılır); docker compose bu değişkeni kendisi okur.
#@ required
COMPOSE_FILE=compose.yml
# Docker Compose proje adı (container ve ağ isimlerinin ön eki).
#@ required
COMPOSE_PROJECT_NAME=spartask
# Uygulama imajı.
#@ required
SPARTASK_IMAGE=ghcr.io/spartaskai/spartask
# Çalışan SparTask sürümü; `spartaskctl update <sürüm>` değiştirir.
#@ required
SPARTASK_VERSION=1.0.0
# Docker iç ağları. Sadece şirket ağınızla çakışırsa değiştirin.
#@ required
SPARTASK_SUBNET=172.30.10.0/24
# Marketplace ön ağı (Caddy, marketplace-web, marketplace-backend).
#@ required
MARKETPLACE_FRONT_SUBNET=172.30.11.0/24
# Marketplace veritabanı ağı (dışarıya kapalı).
#@ required
MARKETPLACE_DATA_SUBNET=172.30.12.0/24

# --- Firma bağlantı hedefleri (ağ güvenliği) -----------------------------------------------------
# Firma süreçlerinin veri kaynakları, mail sunucuları, yapay zeka adresleri, webhook, MCP ve dosya
# indirmeleri için ağ politikası. Stack'in kendi ağları, loopback ve bulut metadata adresleri her
# zaman kapalıdır; özel ağlar (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) aşağıda izin
# verilmedikçe kapalıdır.

# Ek olarak engellenecek IP/CIDR'ler (virgülle). Domain Cloudflare proxy'si arkasındaysa sunucunun
# kendi public IP'sini buraya yazın; değilse yazmayın (firmaların kendi API'nize çağrısı engellenir).
# `spartaskctl config` bunu sizin için kontrol eder ve önerir.
SPARTASK_EGRESS_DENY_CIDRS=
# true: tüm firmalar özel ağlara erişebilir (tek firmalık, kendi sunucusuna kurulum). SaaS'ta false.
#@ required values=true|false
SPARTASK_EGRESS_ALLOW_PRIVATE=false
# Firma bazlı özel ağ istisnaları (JSON). tenant = firma şema adı; host, port ve IP birlikte eşleşir:
# [{"tenant":"tenant_acme","host":"db.musteri.local","port":5432,"cidrs":["10.80.4.20/32"]}]
SPARTASK_EGRESS_PRIVATE_GRANTS=

# --- Domain ve TLS -----------------------------------------------------------------------------
# Uygulamanın domaini (ör. spartask.ai ya da spartask.firma.com.tr). DNS'te domain için A kaydı
# gerekir; firmalar <firma>.<domain> adresinde açılıyorsa * (wildcard) kaydı da.
#@ required
SPARTASK_DOMAIN=
# Caddy'nin hizmet verdiği adresler (virgülle). Boş: domain ve tüm alt alan adları ("<domain>,
# *.<domain>"; wildcard sertifika gerekir, spartask.ai). Tek firmalı kurulumda yalnızca domain
# (spartaskctl install -activation yazar).
SPARTASK_SITES=
# Kök adreste (SPARTASK_DOMAIN) açılan firmanın adresi (alt alan adı). Tek firmalı kurulumda ilk firma
# (spartaskctl install -activation yazar). Boş: kök adres kayıt ve firma bulma sayfasıdır, firmalar
# <firma>.<domain> adresindedir (spartask.ai).
SPARTASK_ROOT_TENANT=
# Sertifika: "/certs/cert.pem /certs/key.pem" = ./certs içindeki sertifika (SPARTASK_SITES'taki adresleri,
# boşsa domain ve *.domain'i kapsar; Cloudflare Origin Certificate veya şirket sertifikası); bir e-posta adresi = Caddy sertifikayı
# Let's Encrypt'ten kendisi alır ve yeniler (yalnızca SPARTASK_SITES tek adresken; 80 ve 443
# portları internetten açık olmalı); "internal" = Caddy kendi CA'sını kullanır (kapalı ağlar;
# tarayıcıların Caddy CA'sına güvenmesi gerekir).
#@ required
SPARTASK_TLS=/certs/cert.pem /certs/key.pem
# İstemci IP'sini bildirmesine güvenilen proxy'ler: private_ranges, ya da domain Cloudflare
# arkasındaysa Cloudflare IP aralıkları (spartaskctl install -cloudflare doldurur).
#@ required
CADDY_TRUSTED_PROXIES=private_ranges

# --- Veritabanı --------------------------------------------------------------------------------
# PostgreSQL kullanıcı adı.
#@ required
DB_USER=spartask
# PostgreSQL veritabanı adı.
#@ required
DB_NAME=spartask
# PostgreSQL şifresi. Kurulumda üretilir; veritabanı oluştuktan sonra buradan değiştirmek yetmez.
#@ required generate=hex:24 install-only
DB_PASSWORD=
# Veritabanının yalnızca sunucunun kendi içinde (127.0.0.1) dinlediği port: kendi bilgisayarından SSH
# tüneliyle bağlanmak için (ör. DBeaver; README "Veritabanına bağlanmak"). Dışarıdan erişilemez.
# Sunucuda bu port başka bir şey tarafından kullanılıyorsa başka bir port yazın.
#@ required
DB_LOCAL_PORT=5433

# --- Gizli anahtarlar (otomatik üretilir) ------------------------------------------------------
# Veri kaynağı / mail sunucusu / yapay zeka şifrelerini şifreler. Kurulumdan sonra ASLA değiştirmeyin.
#@ required generate=hex:32 install-only min=32
SECRET_KEY=
# Bu kurulumun anahtarı. Kurulum lisansı bunun public key'ine bağlanır (parmak izini
# `spartaskctl license show` gösterir); lisans yüklenmeden yeni firma açılamaz. Değişirse yeni lisans
# gerekir: .env'in kopyasıyla birlikte saklayın.
#@ required generate=hex:32 min=64
SPARTASK_INSTALLATION_KEY=
# Kurulum lisansının otomatik yenilendiği lisans servisi (ör. https://accounts.spartask.ai;
# spartaskctl install -activation yazar). Scheduler lisansı bitimine 30 gün kala yeniler; on-prem
# lisans sözleşmesi değiştiyse platform firmasının yöneticisi uygulamada yeni sürümü onaylayınca
# yenilenir. Boş: yenileme yok, lisans elle yüklenir (spartask.ai).
SPARTASK_LICENSE_SERVER=
# Marketplace'in kök firmayı (SPARTASK_ROOT_TENANT) tanıdığı kimlik: onprem.<kurulum kimliği>
# (spartaskctl install -activation yazar). Kök firma marketplace'ten modül kurar; executor lisansları
# kuruluma ve anahtarına bağlıdır, scheduler onları 6 saatte bir lisans servisinden yeniler (ücretli
# executor'lar şimdilik yalnız spartask.ai'de). Boş: spartask.ai, her firma kendi kimliğiyle.
SPARTASK_MARKETPLACE_COMPANY=
# Web oturumlarını imzalar. Değişirse tüm kullanıcıların oturumu kapanır.
#@ required generate=hex:32 min=32
WEB_AUTH_JWT_SECRET=
# API/worker ile NATS mesaj kuyruğu arasındaki iç şifre.
#@ required generate=hex:32 min=32
NATS_AUTH_TOKEN=

# --- Mail (davetler ve kayıt onayı) ------------------------------------------------------------
# Davet ve kayıt onay e-postalarını gönderen SMTP sunucusu. Boşsa e-posta gitmez ve production'da
# şifreyle kayıt kapalıdır (Google ile kayıt çalışır). Bazı sunucu sağlayıcıları 25, 465 ve
# 587 portlarını engeller: o durumda 2525 portlu bir relay kullanın (ör. Brevo smtp-relay.brevo.com).
#@ recommended
INVITATION_SMTP_HOST=
# SMTP portu (STARTTLS).
#@ required if=INVITATION_SMTP_HOST
INVITATION_SMTP_PORT=2525
# SMTP kullanıcı adı.
#@ recommended if=INVITATION_SMTP_HOST
INVITATION_SMTP_USER=
# SMTP şifresi.
#@ recommended if=INVITATION_SMTP_HOST
INVITATION_SMTP_PASSWORD=
# Gönderen adresi, ör. "SparTask <no-reply@spartask.ai>".
#@ required if=INVITATION_SMTP_HOST
INVITATION_SMTP_FROM=
# Davet bağlantısının geçerlilik süresi.
#@ required
INVITATION_TTL=72h
# Bir firmanın saatte gönderebileceği en fazla davet.
#@ required
INVITATION_HOURLY_LIMIT=50

# --- Giriş -------------------------------------------------------------------------------------
# "Google ile giriş" için Google Identity web client ID. Boşsa Google ile giriş gizlenir.
GOOGLE_CLIENT_ID=

# --- Marketplace bağlantısı --------------------------------------------------------------------
# Stüdyoda gösterilen marketplace web adresi (boşsa bağlantı gizlenir).
SPARTASK_MARKETPLACE_URL=
# Yöneticilere gösterilen "Abonelik" linki için lisans servisi adresi (ör. https://accounts.spartask.ai);
# link <adres>/billing sayfasını açar (boşsa bağlantı gizlenir). Yalnız SaaS kurulumunda doldurulur.
SPARTASK_BILLING_URL=

# --- Yasal metinler ------------------------------------------------------------------------------
# Kurulumu işletenin yasal metinleri. spartask.ai lisans servisindeki metinlerine bağlanır
# (ör. https://accounts.spartask.ai/yasal/kullanim-kosullari). Müşterinin kendi sunucusundaki
# kurulumda boş kalır: SparTask'ın metinleri müşterinin kullanıcılarına gösterilmez.
# Kullanım koşulları: doluysa firma kaydında ve davetle yeni hesap açılırken kabul edilir (kabul
# edilen sürüm kaydedilir); boşsa kabul sorulmaz.
SPARTASK_TERMS_URL=
# Aydınlatma metni: giriş, kayıt ve davet sayfalarında bağlantı olarak gösterilir. Kendi
# sunucusuna kuran firma çalışanlarına karşı veri sorumlusudur; kendi metninin adresini yazabilir.
SPARTASK_PRIVACY_NOTICE_URL=
# Tüm yasal metinlerin listesi (giriş sayfasında "Sözleşmeler" bağlantısı; boşsa gizlenir).
SPARTASK_LEGAL_URL=
# Online modül kurulumu için marketplace API adresi (boşsa sadece dosyayla kurulum).
MARKETPLACE_API_URL=
# Tarayıcıdan kurulum isteği gönderebilecek marketplace adresleri (virgülle).
MARKETPLACE_ALLOWED_ORIGINS=

# --- Lisans servisi (yalnız spartask.ai SaaS; on-premise kurulumlar boş bırakır) -----------------
# Lisans servisinin adresi, ör. https://accounts.spartask.ai. Doluysa scheduler firma lisanslarını
# eşitler ve firmaları lisans servisine bağlar; API yeni firmayı kayıtta hemen bağlar.
LICENSE_SERVICE_URL=
# Lisans servisinin çekirdek API token'ı (lisans sunucusunda config aracı üretir ve bir kez gösterir;
# orada yalnızca SHA-256'sı LICENSE_CORE_TOKEN_SHA256 olarak saklanır).
#@ required if=LICENSE_SERVICE_URL min=32
LICENSE_CORE_TOKEN=
# Lisans eşitleme ve firma bağlama aralığı (boş: 5m; 1m-1h).
LICENSE_SYNC_INTERVAL=

# --- Marketplace sunucusu (sadece compose.marketplace.yml ile) ---------------------------------
# Marketplace domaini, ör. marketplace.spartask.ai
#@ required stack=marketplace
MARKETPLACE_DOMAIN=
# Çalışan marketplace sürümü.
#@ required stack=marketplace
MARKETPLACE_VERSION=
# Marketplace veritabanı şifresi (kurulumda üretilir).
#@ required stack=marketplace generate=hex:24 install-only
MARKETPLACE_DB_PASSWORD=

# --- Platform olayları ve platform API'si ------------------------------------------------------
# tenant.created olayının (yeni firma) X-Webhook-Token ile POST edileceği adres; ör. kendi firmanızdaki
# API Dinleyici süreci: https://<firmanız>.<domain>/api/webhooks/tenant-created. Boşsa olaylar bekler.
#@ recommended
PLATFORM_EVENTS_WEBHOOK_URL=
# Yukarıdaki API Dinleyici sürecinin güvenlik anahtarı.
#@ required if=PLATFORM_EVENTS_WEBHOOK_URL
PLATFORM_EVENTS_WEBHOOK_TOKEN=
# Platformu işleten firmanın kimliği (public.tenants.id, virgülle birden fazla). Sadece bu firma
# GET /api/platform/tenants ile firma listesini alabilir (hatırlatıcılar, raporlar); yöneticileri
# kurulum lisansını görür ve değişen on-prem lisans sözleşmesini onaylar. Tek firmalı kurulumda o
# firmadır (spartaskctl install -activation yazar).
# `spartaskctl config` sunucudaki firmaları listeler.
#@ recommended
SPARTASK_PLATFORM_TENANT_IDS=
# Platform API'sini süreçlerden çağırmak için anahtar: HTTP İstemcisi düğümünde
# X-Spartask-Platform-Token başlığına yazılır. Otomatik üretilir; görmek için: grep TOKEN .env
#@ generate=hex:32 min=32
SPARTASK_PLATFORM_API_TOKEN=

# --- Mobil uygulama ----------------------------------------------------------------------------
# APK'yı ./mobile/spartask.apk olarak koyun; web portal QR kodla sunar.

# Uygulamada gösterilen mobil sürüm numarası.
MOBILE_APP_VERSION=
# APK harici bir adresteyse (ör. GitHub release) o adres.
MOBILE_APK_URL=
# Telefonların bağlandığı API adresi (boşsa tarayıcının adresi + /api).
SPARTASK_PUBLIC_API_URL=

# --- MCP (varsayılan kapalı) -------------------------------------------------------------------
# Yapay zeka asistanları için MCP sunucusu.
#@ required values=true|false
MCP_ENABLED=false
# Web arayüzünden MCP token üretimi (sadece ADMIN).
#@ required values=true|false
MCP_TOKEN_ISSUANCE_ENABLED=false
# MCP kaynak adresi; yolu /mcp olmalı, ör. https://spartask.ai/mcp
#@ required if=MCP_ENABLED=true
MCP_RESOURCE_URL=
# MCP token'larını yayınlayan kimlik sağlayıcı (issuer).
#@ required if=MCP_ENABLED=true
MCP_JWT_ISSUER=

# --- Kayıt -------------------------------------------------------------------------------------
# Yeni firma kaydı: open (herkes), invite (yalnızca platform firmasının ürettiği davet bağlantısıyla) veya closed (kapalı). Davetler e-postaya bağlı, tek kullanımlık ve 7 gün geçerlidir.
#@ required values=open|invite|closed
SPARTASK_SIGNUP_MODE=open
# Davetsiz gelenlere kayıt sayfasında gösterilecek iletişim adresi (ör. info@spartask.ai). Boşsa adres gösterilmez.
SPARTASK_SIGNUP_CONTACT_EMAIL=

# --- Yedekler ----------------------------------------------------------------------------------
# `spartaskctl backup` komutunun ./backups içinde tuttuğu yedek sayısı.
#@ required
BACKUP_KEEP=14
# Yedekleri (veritabanı dökümleri, dosyalar, .env) şifreler; sunucu dışına kopyalanan yedek bu anahtar olmadan okunamaz. Otomatik üretilir; SECRET_KEY ile birlikte şifre yöneticisinde saklayın, kaybolursa yedekler açılamaz.
#@ required generate=hex:32 min=32
BACKUP_ENCRYPTION_KEY=
