# Marketplace gizli ayarları (compose.marketplace.yml). `spartaskctl install --with-marketplace` bu
# dosyadan marketplace.env üretir (mode 600). Veritabanı, adresler ve CORS .env'den türetilir.
# "#@" etiketlerinin anlamı .env.example başında açıklanmıştır.

# Lisans imzalama anahtarı (base64 Ed25519). Public key'i .env içindeki MARKETPLACE_PUBLIC_KEY'dir;
# kurulumda çift olarak üretilir, sonradan değişirse verilmiş lisanslar geçersiz olur.
#@ required
ED25519_PRIVATE_KEY=
# Marketplace oturumlarını imzalar (en az 32 karakter).
#@ required generate=hex:32 min=32
JWT_SECRET=
# Spartask motorunun ön kontrol erişim anahtarı (en az 24 karakter).
#@ required generate=hex:24 install-only min=24
ENGINE_API_KEY=
# CI'dan executor ve paket yayınlama anahtarı (GitHub organizasyon secret'ı MARKETPLACE_PUBLISH_KEY).
#@ required generate=hex:24 install-only min=24
PUBLISH_API_KEY=
# "Spartask ile giriş yap"; .env içindeki MARKETPLACE_SSO_SHARED_SECRET ile aynı olmalı.
#@ required min=32
SSO_SHARED_SECRET=
# SSO token yayıncısı (.env MARKETPLACE_SSO_ISSUER ile aynı).
#@ required
SSO_ISSUER=spartask-platform
# SSO token hedefi (.env MARKETPLACE_SSO_AUDIENCE ile aynı).
#@ required
SSO_AUDIENCE=spartask-marketplace
# Kurulum makbuzlarının hedefi (.env MARKETPLACE_RECEIPT_AUDIENCE ile aynı).
#@ required
RECEIPT_AUDIENCE=spartask-marketplace-receipts
# Marketplace'te yönetici rolü olan Spartask firmaları (public.tenants.id, virgülle).
#@ recommended
MARKETPLACE_ADMIN_TENANT_IDS=
# Marketplace'te iş ortağı (yayıncı) rolü olan firmalar.
MARKETPLACE_PARTNER_TENANT_IDS=
# Demo verisi; production'da false kalmalı.
#@ required values=false|true
SEED_DEMO_DATA=false
# Resmi paketlerin otomatik onayı.
#@ required values=false|true
PACKAGE_AUTO_APPROVE_OFFICIAL=false
# Tek dosya yükleme sınırı (MB).
#@ required
MAX_UPLOAD_MB=50
# Paket boyutu sınırı (MB).
#@ required
MAX_PACKAGE_MB=5
# Ödeme sağlayıcıları (boş: ücretli lisanslar sadece yönetici tarafından verilir).
PAYMENT_PROVIDERS=
