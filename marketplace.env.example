# Marketplace gizli ayarları (compose.marketplace.yml). `spartaskctl install --with-marketplace` bu
# dosyadan marketplace.env üretir (mode 600). Veritabanı, adresler ve CORS .env'den türetilir.
# "#@" etiketlerinin anlamı .env.example başında açıklanmıştır.

# Modül kurulum izni imzalama anahtarı (base64 Ed25519). Üretilmez: `spartaskctl install -marketplace-signing-key`
# ile şifre yöneticisindeki platform anahtarı verilir. SparTask sürümleri yalnızca koda gömülü public
# key'lerle doğrular (spartask_backend/pkg/crypto/license/keys.go); başka bir anahtarla imzalanan
# kurulum izinleri reddedilir. Executor lisanslarını lisans servisi imzalar.
#@ required
ED25519_PRIVATE_KEY=
# Marketplace oturumlarını imzalar (en az 32 karakter).
#@ required generate=hex:32 min=32
JWT_SECRET=
# CI'dan executor ve paket yayınlama anahtarı (GitHub organizasyon secret'ı MARKETPLACE_PUBLISH_KEY).
#@ required generate=hex:24 install-only min=24
PUBLISH_API_KEY=
# Lisans servisinin adresi, ör. https://accounts.spartask.ai: executor lisanslarını imzalar ve ücretli
# executor'ları abonelikle satar; marketplace yayınlanan executor'ları oraya kaydeder.
#@ required
LICENSE_SERVICE_URL=
# Lisans servisinin marketplace API jetonu (lisans sunucusunda config aracı üretir ve bir kez gösterir; orada yalnızca
# SHA-256'sı LICENSE_MARKETPLACE_TOKEN_SHA256 olarak saklanır). Elle girilir (en az 32 karakter).
#@ required min=32
LICENSE_MARKETPLACE_TOKEN=
# Marketplace'e giriş yalnızca "SparTask hesabıyla giriş" ile yapılır: SparTask hesap sağlayıcısının
# (lisans servisi) adresi, ör. https://accounts.spartask.ai. İstemci lisans servisinde kaydedilir
# (kind web, yönlendirme https://<MARKETPLACE_DOMAIN>/api/v1/auth/account/callback).
#@ required
SPARTASK_ACCOUNTS_ISSUER=
# Lisans servisindeki istemci kimliği.
SPARTASK_ACCOUNTS_CLIENT_ID=marketplace
# İstemci kaydında bir kez gösterilen secret (en az 24 karakter).
#@ required min=24
SPARTASK_ACCOUNTS_CLIENT_SECRET=
# Marketplace'te yönetici rolü olan Spartask firmaları (public.tenants.id, virgülle).
#@ recommended
MARKETPLACE_ADMIN_TENANT_IDS=
# Marketplace'te iş ortağı (yayıncı) rolü olan firmalar.
MARKETPLACE_PARTNER_TENANT_IDS=
# Demo verisi; production'da false kalmalı.
#@ required values=false|true
SEED_DEMO_DATA=false
# Resmi paketlerin otomatik onayı.
#@ required values=false|true
PACKAGE_AUTO_APPROVE_OFFICIAL=false
# İncelemeye düşen paket sürümlerinin bildirileceği adres: platform firmasında Altyapı > Gelen
# Webhooklar'daki "marketplace-package-review" kaydı, ör. https://<platform-firma>.spartask.ai/api/webhooks/marketplace-package-review.
# Boşsa bildirim gönderilmez; sürümler API ile admin oturumundan onaylanır.
#@ recommended
REVIEW_WEBHOOK_URL=
# Bildirimin X-Webhook-Token başlığı; o gelen webhook kaydının token'ıyla aynı olmalı (bu değeri kayda girin).
#@ generate=hex:24 min=24
REVIEW_WEBHOOK_TOKEN=
# İnceleme sürecinin kararı X-Review-Key başlığıyla göndermesini sağlar: platform firmasında Altyapı >
# API Bağlantıları'ndaki "marketplace" bağlantısının gizli değeri (başlık adı X-Review-Key).
# Boşsa karar yalnızca admin oturumuyla verilir.
#@ generate=hex:24 min=24
REVIEW_API_KEY=
# Tek dosya yükleme sınırı (MB).
#@ required
MAX_UPLOAD_MB=50
# Paket boyutu sınırı (MB).
#@ required
MAX_PACKAGE_MB=5
