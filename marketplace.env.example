# Marketplace secrets (compose.marketplace.yml). `spartaskctl install --with-marketplace` writes
# this file as marketplace.env (mode 600). Database, URLs and CORS are derived from .env.

# License signing key (base64 Ed25519). Its public key is MARKETPLACE_PUBLIC_KEY in .env.
ED25519_PRIVATE_KEY=
# Marketplace sessions (>= 32 characters).
JWT_SECRET=
# Spartask Engine pre-flight access (>= 24 characters).
ENGINE_API_KEY=
# CI publishing of executors and packages (GitHub org secret MARKETPLACE_PUBLISH_KEY).
PUBLISH_API_KEY=
# "Spartask ile giriş yap"; equals MARKETPLACE_SSO_SHARED_SECRET in .env.
SSO_SHARED_SECRET=
SSO_ISSUER=spartask-platform
SSO_AUDIENCE=spartask-marketplace
RECEIPT_AUDIENCE=spartask-marketplace-receipts
# Spartask companies (public.tenants.id, comma separated) with marketplace roles.
MARKETPLACE_ADMIN_TENANT_IDS=
MARKETPLACE_PARTNER_TENANT_IDS=
SEED_DEMO_DATA=false
PACKAGE_AUTO_APPROVE_OFFICIAL=false
MAX_UPLOAD_MB=50
MAX_PACKAGE_MB=5
PAYMENT_PROVIDERS=
